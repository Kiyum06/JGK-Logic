<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>

    <header class="hero">
        <div class="hero-content">
            <h1><%= title %></h1>
            <p><%= subtitle %></p>
        </div>

        <nav>
            <a href="/login">/login</a>
            <a href="/register">/registerr</a>
            <a href="/products">/products</a>
        </nav>

        <div class="hero-image">
            <img
                src="/images/default.webp"
                alt="Model View Controller Architecture Diagram"
            />
        </div>
    </header>

    <main class="container">
        <section class="card">
            <h2>Resistance bands</h2>

            <p>
                A resistance band that helps you warm up and avoid injuries and soreness from your workouts!
            </p>

            <img src="https://placehold.co/300x200" alt="placeholder image">

            <p>$9.99</p>

        </section>
    </main>

    <footer class="footer">
        <p>Node + Express MVC Starter</p>
    </footer>

</body>
</html>
